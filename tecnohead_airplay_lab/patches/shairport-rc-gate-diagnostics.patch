diff --git a/ap2_event_receiver.c b/ap2_event_receiver.c
--- a/ap2_event_receiver.c
+++ b/ap2_event_receiver.c
@@ -132,6 +132,7 @@ static void ap2_mr_forward_one(rtsp_conn_info *conn, int kind, uint64_t *last_ge
   uint64_t generation = 0;
   if (ap2_mr_snapshot_copy(kind, *last_generation, &data, &length, &generation) == 0)
     return;
+  debug(1, "TECNOHEAD_RC_SNAPSHOT_READY_%s", kind == 0 ? "NOW_PLAYING" : "COMMANDS");
   plist_t command = NULL;
   plist_from_bin(data, length, &command);
   free(data);
@@ -140,7 +141,13 @@ static void ap2_mr_forward_one(rtsp_conn_info *conn, int kind, uint64_t *last_ge
     ssize_t result = ap2_event_port_post_command(conn, command);
     if (result > 0)
       debug(1, "TECNOHEAD_RC_MEDIAREMOTE_ACK_%s", kind == 0 ? "NOW_PLAYING" : "COMMANDS");
+    else
+      debug(1, "TECNOHEAD_RC_MEDIAREMOTE_SEND_FAILED_%s",
+            kind == 0 ? "NOW_PLAYING" : "COMMANDS");
     plist_free(command);
+  } else {
+    debug(1, "TECNOHEAD_RC_SNAPSHOT_DECODE_FAILED_%s",
+          kind == 0 ? "NOW_PLAYING" : "COMMANDS");
   }
 }
 
@@ -226,13 +233,23 @@ void *ap2_event_receiver(void *arg) {
       debug(1, "TECNOHEAD_RC_UPDATE_INFO_ACK");
 
     uint64_t mr_seen[2] = {0, 0};
+    unsigned int previous_rc_gate = ~0U;
     while (1) {
-      if (conn->airplay_stream_category == remote_control_stream && conn->running &&
-          conn->event_channel_fd > 0 && !conn->ap2_event_receiver_exited &&
-          conn->ap2_pairing_context.event_cipher_bundle.cipher_ctx != NULL &&
-          config.enable_HK_Access_Control != 0) {
-        ap2_mr_forward_one(conn, 1, &mr_seen[1]); // capabilities before track state
-        ap2_mr_forward_one(conn, 0, &mr_seen[0]);
+      if (conn->airplay_stream_category == remote_control_stream) {
+        unsigned int rc_gate = (conn->running ? 1U : 0U) |
+                               (conn->event_channel_fd > 0 ? 2U : 0U) |
+                               (!conn->ap2_event_receiver_exited ? 4U : 0U) |
+                               (conn->ap2_pairing_context.event_cipher_bundle.cipher_ctx != NULL
+                                    ? 8U : 0U) |
+                               (config.enable_HK_Access_Control != 0 ? 16U : 0U);
+        if (rc_gate != previous_rc_gate) {
+          debug(1, "TECNOHEAD_RC_GATE_MASK_%u", rc_gate);
+          previous_rc_gate = rc_gate;
+        }
+        if (rc_gate == 31U) {
+          ap2_mr_forward_one(conn, 1, &mr_seen[1]); // capabilities before track state
+          ap2_mr_forward_one(conn, 0, &mr_seen[0]);
+        }
       }
       usleep(100000);
     };
