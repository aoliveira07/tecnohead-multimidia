+static void ap2_mr_forward_one(rtsp_conn_info *conn, int kind, uint64_t *last_generation) {
+  char *data = NULL;
+  uint32_t length = 0;
+  uint64_t generation = 0;
+  if (ap2_mr_snapshot_copy(kind, *last_generation, &data, &length, &generation) == 0)
+    return;
+  plist_t command = NULL;
+  plist_from_bin(data, length, &command);
+  free(data);
+  *last_generation = generation; // never retry a stalled or rejected event in a tight loop
+  if (command != NULL) {
+    ssize_t result = ap2_event_port_post_command(conn, command);
+    if (result > 0)
+      debug(1, "TECNOHEAD_RC_MEDIAREMOTE_ACK_%s", kind == 0 ? "NOW_PLAYING" : "COMMANDS");
+    plist_free(command);
+  }
+}
