diff --git a/rtsp.c b/rtsp.c
index 3e66903..2e15d5a 100644
--- a/rtsp.c
+++ b/rtsp.c
@@ -144,6 +144,116 @@ pthread_rwlock_t principal_conn_lock = PTHREAD_RWLOCK_INITIALIZER;
 // always lock this when accessing the list of connection threads
 pthread_mutex_t conns_lock = PTHREAD_MUTEX_INITIALIZER;
 
+#ifdef CONFIG_AIRPLAY_2
+// Opt-in, per-process relay cache. TecnoHead starts one receiver process per zone.
+// Never log the plist: it may contain track metadata and artwork.
+#define AP2_MR_NOW_PLAYING_LIMIT (512U * 1024U)
+#define AP2_MR_COMMANDS_LIMIT (64U * 1024U)
+typedef struct {
+  char *data;
+  uint32_t length;
+  uint64_t generation;
+} ap2_mr_item;
+static pthread_mutex_t ap2_mr_lock = PTHREAD_MUTEX_INITIALIZER;
+static ap2_mr_item ap2_mr_items[2];
+static int ap2_mr_owner = 0;
+
+static int ap2_mr_enabled(void) {
+  const char *value = getenv("TECNOHEAD_RC_NOW_PLAYING");
+  return value != NULL && strcmp(value, "1") == 0;
+}
+
+static void ap2_mr_clear_owner(int connection_number) {
+  pthread_mutex_lock(&ap2_mr_lock);
+  if (connection_number == 0 || ap2_mr_owner == connection_number) {
+    for (int i = 0; i < 2; i++) {
+      free(ap2_mr_items[i].data);
+      ap2_mr_items[i].data = NULL;
+      ap2_mr_items[i].length = 0;
+    }
+    ap2_mr_owner = 0;
+  }
+  pthread_mutex_unlock(&ap2_mr_lock);
+}
+
+static void ap2_mr_record(rtsp_conn_info *conn, const char *data, uint32_t length) {
+  if (!ap2_mr_enabled() || conn == NULL || data == NULL || length == 0 ||
+      length > AP2_MR_NOW_PLAYING_LIMIT || conn->airplay_stream_category != ptp_stream)
+    return;
+
+  pthread_rwlock_rdlock(&principal_conn_lock);
+  int is_audio_owner = principal_conn == conn;
+  pthread_rwlock_unlock(&principal_conn_lock);
+  if (!is_audio_owner)
+    return;
+
+  plist_t command = NULL;
+  plist_from_memory(data, length, &command);
+  if (command == NULL)
+    return;
+  plist_t type_item = plist_dict_get_item(command, "type");
+  char *type = NULL;
+  if (type_item != NULL)
+    plist_get_string_val(type_item, &type);
+  int kind = -1;
+  if (type != NULL && strcmp(type, "updateMRNowPlayingInfo") == 0)
+    kind = 0;
+  else if (type != NULL && strcmp(type, "updateMRSupportedCommands") == 0)
+    kind = 1;
+  free(type);
+  plist_free(command);
+  if (kind < 0 || (kind == 1 && length > AP2_MR_COMMANDS_LIMIT))
+    return;
+
+  char *copy = malloc(length);
+  if (copy == NULL)
+    return;
+  memcpy(copy, data, length);
+  pthread_rwlock_rdlock(&principal_conn_lock);
+  if (principal_conn == conn) {
+    pthread_mutex_lock(&ap2_mr_lock);
+    if (ap2_mr_owner != conn->connection_number) {
+      for (int i = 0; i < 2; i++) {
+        free(ap2_mr_items[i].data);
+        ap2_mr_items[i].data = NULL;
+        ap2_mr_items[i].length = 0;
+      }
+      ap2_mr_owner = conn->connection_number;
+    }
+    free(ap2_mr_items[kind].data);
+    ap2_mr_items[kind].data = copy;
+    ap2_mr_items[kind].length = length;
+    ap2_mr_items[kind].generation++;
+    copy = NULL;
+    pthread_mutex_unlock(&ap2_mr_lock);
+  }
+  pthread_rwlock_unlock(&principal_conn_lock);
+  free(copy);
+}
+
+int ap2_mr_snapshot_copy(int command_kind, uint64_t last_generation, char **data,
+                         uint32_t *length, uint64_t *generation) {
+  if (!ap2_mr_enabled() || command_kind < 0 || command_kind > 1 || data == NULL ||
+      length == NULL || generation == NULL)
+    return 0;
+  int result = 0;
+  pthread_mutex_lock(&ap2_mr_lock);
+  ap2_mr_item *item = &ap2_mr_items[command_kind];
+  if (item->data != NULL && item->length > 0 && item->generation != last_generation) {
+    char *copy = malloc(item->length);
+    if (copy != NULL) {
+      memcpy(copy, item->data, item->length);
+      *data = copy;
+      *length = item->length;
+      *generation = item->generation;
+      result = 1;
+    }
+  }
+  pthread_mutex_unlock(&ap2_mr_lock);
+  return result;
+}
